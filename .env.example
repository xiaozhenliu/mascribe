# MaScribe 配置参考文档
# MaScribe Configuration Reference
#
# 注意：本文件仅作为配置项文档参考，应用不会读取 .env 文件
# Note: This file is for documentation only. The app does not read .env files.
#
# 实际运行时配置存储位置 / Actual runtime config location:
# - macOS: ~/Library/Application Support/com.mascribe/config.json
# - Windows: %APPDATA%\com.mascribe\config.json
#
# 所有配置项可通过应用内设置界面修改 / All settings can be modified via the in-app settings UI

# =============================================================================
# 语音识别 / Speech Recognition
# =============================================================================

# 语音识别模型目录 / SenseVoice model directory
# 默认 / Default: ~/Library/Application Support/com.mascribe/models/sensevoice/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
MODEL_DIR=

# 识别语言 / Recognition language
# 选项 / Options: auto (自动检测), zh (中文), en (英语), ja (日语), ko (韩语), yue (粤语)
LANGUAGE=auto

# 线程数 / Number of threads (默认 / default: 4)
NUM_THREADS=4

# 启用逆文本规范化 / Enable Inverse Text Normalization
# 将"一千二百三十四"转为"1234" / Converts "一千二百三十四" to "1234"
USE_ITN=true

# =============================================================================
# 全局快捷键 / Global Shortcut
# =============================================================================

# 快捷键组合 / Shortcut combination
# 默认 / Default: Alt+Space
# 示例 / Examples: Ctrl+Shift+V, CmdOrCtrl+Alt+R, F13
SHORTCUT=Alt+Space

# =============================================================================
# AI 润色 / AI Polishing
# =============================================================================

# 润色引擎 / Polishing engine
# 选项 / Options: off (关闭), local (本地模型), api (在线API)
POLISH_MODE=off

# 本地模型路径 / Local GGUF model path (仅 polish_mode=local 时使用)
# 推荐 / Recommended: Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
# 示例 / Example: ~/Library/Application Support/com.mascribe/models/qwen2.5-1.5b/qwen2.5-1.5b-instruct-q4_k_m.gguf
POLISH_MODEL_PATH=

# 在线 API 端点 / Online API endpoint (仅 polish_mode=api 时使用)
# Ollama: http://localhost:11434/v1
# OpenAI: https://api.openai.com/v1
# 其他兼容服务 / Other compatible services
API_ENDPOINT=http://localhost:11434/v1

# API 密钥 / API key (Ollama 留空，OpenAI 必填)
API_KEY=

# 模型名称 / Model name
# Ollama 示例 / Examples: qwen2.5:1.5b, llama3.2:3b, glm4:9b
# OpenAI 示例 / Examples: gpt-4o-mini, gpt-3.5-turbo
API_MODEL=qwen2.5:1.5b

# AI 润色提示词模板 / AI polish prompt template
# 占位符 / Placeholders: {text} = 转写文本, {lang} = 语言代码
# 默认提示词会移除口语填充词、修正标点、修复同音字错误
POLISH_PROMPT=见应用内默认值 / See in-app default

# =============================================================================
# 截图 OCR 上下文 / Screenshot OCR Context
# =============================================================================

# OCR 模式 / OCR mode
# 选项 / Options: disabled (禁用), save (仅保存截图), api (OCR识别)
SCREENSHOT_MODE=disabled

# 截图最大尺寸 / Max screenshot dimension (0 = 无限制 / no limit)
SCREENSHOT_MAX_SIZE=1920

# 视觉模型模式 / Vision mode
# 选项 / Options: disabled (禁用), local (本地多模态模型), api (在线OCR API)
VISION_MODE=disabled

# 本地视觉模型路径 / Local vision model path (MiniCPM-V 或 Qwen2-VL)
# 示例 / Example: ~/Library/Application Support/com.mascribe/models/minicpm-v-2_6
VISION_MODEL_PATH=

# 视觉模型最大图像尺寸 / Vision model max image size (0 = 无限制 / no limit)
VISION_MAX_IMAGE_SIZE=1024

# OCR API 端点 / OCR API endpoint (用于 Ollama OCR 模式)
# 示例 / Example: http://localhost:11434/v1
OCR_ENDPOINT=http://localhost:11434/v1

# OCR 模型名称 / OCR model name
# 示例 / Example: glm-ocr, minicpm-v
OCR_MODEL=glm-ocr

# =============================================================================
# 录音保存 / Recordings
# =============================================================================

# 录音文件保存目录 / Recordings directory
# 默认 / Default: ~/Library/Application Support/com.mascribe/recordings
RECORDINGS_DIR=

# =============================================================================
# 开发设置 / Development Settings
# =============================================================================

# 日志级别 / Log level
# 选项 / Options: error, warn, info, debug, trace
RUST_LOG=info

# 启用 Tauri 开发工具 / Enable Tauri devtools
TAURI_DEVTOOLS=false
